# ==============================================================================
# MessMate Backend Environment Variables (Production & Development)
# Render Web Service Configuration (rootDir: backend)
# ==============================================================================

PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> Database -> Connection string (URI)
# Use sslmode=require for all cloud connections.
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# Supabase Storage & Client API
# ------------------------------------------------------------------------------
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SERVICE_ROLE_KEY]"

# ------------------------------------------------------------------------------
# Authentication & JWT Configuration
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="[SECURE_RANDOM_HEX_STRING_AT_LEAST_32_CHARS]"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# CORS / Frontend Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Note: *.vercel.app is allowed by default.
FRONTEND_URL="https://baramatimesswala.com"

# ------------------------------------------------------------------------------
# Storage / Upload Directory
# ------------------------------------------------------------------------------
UPLOAD_DIR="uploads"

# ------------------------------------------------------------------------------
# WhatsApp Business Cloud API (Optional - defaults to mock logger)
# ------------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v21.0"

# ------------------------------------------------------------------------------
# Firebase Admin SDK (Server Phone OTP ID Token Verification)
# ------------------------------------------------------------------------------
# Option A: Full Service Account JSON string (paste entire json on Render)
FIREBASE_SERVICE_ACCOUNT_KEY=""
# Option B: Individual Service Account credentials
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Owner Recovery Phone Number for Mobile OTP
OWNER_PHONE="+919822334455"
