PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Database URLs
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Project Credentials & Storage
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SERVICE_ROLE_KEY]"

# Authentication
JWT_SECRET="[SECURE_RANDOM_STRING_AT_LEAST_32_CHARS]"
JWT_EXPIRES_IN="7d"

# Frontend Allowed Origin
FRONTEND_URL="https://baramatimesswala.com"

# Upload Directory
UPLOAD_DIR="uploads"

# WhatsApp Business Cloud API Configuration
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v21.0"
