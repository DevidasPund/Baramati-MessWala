# ==============================================================================
# MessMate – Smart Mess & Tiffin Management System (Baramati Messwala)
# Root Environment Variables Template & Reference
# ==============================================================================
# This template documents all environment variables required for deploying
# MessMate to Render (Backend Web Service) and Vercel (Frontend SPA).
# DO NOT COMMIT ACTUAL SECRETS OR VALUES TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (Deploy to Render: rootDir=backend)
# ------------------------------------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Database (Direct connection & Pooler)
# Obtain these from: Supabase Dashboard -> Project Settings -> Database
# DATABASE_URL: Transaction pooler connection string (Port 6543 or 5432 with ?sslmode=require)
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
# DIRECT_URL: Direct session connection string for Prisma migrations
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Storage & Client API
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR_SUPABASE_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SUPABASE_SERVICE_ROLE_KEY]"

# Authentication & Security
# Generate a secure 64-character random string (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="[YOUR_GENERATED_64_CHAR_HEX_SECRET]"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin(s)
# Set to your deployed Vercel domain or custom domain (e.g., https://baramatimesswala.com)
# Multiple origins can be comma-separated: https://baramatimesswala.com,https://messmate.vercel.app
FRONTEND_URL="https://baramatimesswala.com"

# Upload Directory
UPLOAD_DIR="uploads"

# WhatsApp Business Cloud API (Optional - uses mock logger when disabled)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v21.0"


# ------------------------------------------------------------------------------
# 2. FRONTEND SPA (Deploy to Vercel: rootDir=frontend)
# ------------------------------------------------------------------------------

# Public Backend API URL (Points to the deployed Render Web Service)
# Example: https://messmate-backend.onrender.com/api
VITE_API_URL="https://messmate-backend.onrender.com/api"

# Branding & Client Metadata
VITE_APP_NAME="MessMate"
VITE_BUSINESS_NAME="Baramati Messwala"
