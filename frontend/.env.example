# ==============================================================================
# MessMate Frontend Environment Variables (Vercel SPA - rootDir: frontend)
# ==============================================================================

# Public Backend API URL (Points to the deployed Render Web Service)
# For Render deployment: https://messmate-backend.onrender.com/api
# For Custom Domain: https://api.baramatimesswala.com/api
# For Local Development: http://localhost:5000/api
VITE_API_URL="https://messmate-backend.onrender.com/api"

# Branding & Metadata
VITE_APP_NAME="MessMate"
VITE_BUSINESS_NAME="Baramati Messwala"

# Firebase Phone Authentication (Web Client)
# Obtain from: Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
